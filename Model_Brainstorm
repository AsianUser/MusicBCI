# ─────────────────────────────────────────
# 4. MODEL ARCHITECTURE
# ─────────────────────────────────────────
class SpatialTemporalCNN(nn.Module):
    """
    Multi-level Spatial-Temporal CNN for 7-channel EEG.

    Input  : (batch, time_steps, n_channels=7)
    Output : (batch, n_classes)

    Levels of feature discovery
    ───────────────────────────
    Level 0 – Spatial Conv  : mixes signals across the 7 EEG channels,
                              learning cross-electrode relationships (spatial filters).
    Level 1 – Temporal fine : small kernel → sharp edges, fast oscillations (beta/gamma).
    Level 2 – Temporal mid  : medium kernel → rhythmic bursts (alpha/theta).
    Level 3 – Temporal coarse: large kernel + dilation → slow drifts (delta).



    """

    def __init__(
        self,
        n_channels:       int = 7, # EEG Channels
        n_classes:        int = 7, # LR Jaw, LR Face, LR blink, blink
        n_spatial_filters: int = 32,
        n_temporal_filters: int = 64,
        dropout:          float = 0.5,
    ):
        super().__init__()

        # ── Level 0: Spatial conv across channels ──────────────────────────
        # Treats the 7 channels as a 1-D "spatial" axis.
        # kernel_size = n_channels learns a full spatial mixture;
        # padding='same' keeps the time dimension intact.
        self.spatial_conv = nn.Sequential(
            nn.Conv1d(
                in_channels  = n_channels,
                out_channels = n_spatial_filters,
                kernel_size  = n_channels,   # kernel across all 7 channels!
                padding      = n_channels // 2, # =3 (3+3+1), padded so output time steps = input time steps
            ),
            nn.BatchNorm1d(n_spatial_filters),
            nn.ELU(), # soft ReLU, negative = -1 smoothly surpressed, positive = linear
            nn.Dropout(dropout * 0.5), # ends up being 0.25!
        )

        # ── Level 1: Fine-grained temporal (kernel=3) ──────────────────
        self.temporal_fine = nn.Sequential(
            nn.Conv1d(n_spatial_filters, n_temporal_filters,
                      kernel_size=3, padding=1), # padding = 1 allows kernel to be centered → output time steps = input time steps
            nn.BatchNorm1d(n_temporal_filters),
            nn.ELU(),
            nn.MaxPool1d(kernel_size=2),          # halve time resolution
            nn.Dropout(dropout * 0.5),
        )

        # ── Level 2: Mid-level temporal (kernel=7) ────────────────────
        self.temporal_mid = nn.Sequential(
            nn.Conv1d(n_temporal_filters, n_temporal_filters,
                      kernel_size=7, padding=3), # same as above applied
            nn.BatchNorm1d(n_temporal_filters),
            nn.ELU(),
            nn.MaxPool1d(kernel_size=2),
            nn.Dropout(dropout),
        )

        # ── Level 3: Coarse temporal (large kernel + dilation) ────────────
        self.temporal_coarse = nn.Sequential(
            nn.Conv1d(n_temporal_filters, n_temporal_filters,
                      kernel_size=7, dilation=4, padding=12),
                      # dilation=4 → kernel covers 7 + (7-1)*(4-1) = 25 time steps, padding=12 to keep output time steps = input time steps
                      # Ex. k1 = t1, k2 = t5... k7=25!
            nn.BatchNorm1d(n_temporal_filters),
            nn.ELU(),
            nn.MaxPool1d(kernel_size=2),
            nn.Dropout(dropout),
        )

        # ── Classifier head ────────────────────────────────────────────────
        self.pool       = nn.AdaptiveAvgPool1d(1)    # collapse time → scalar
        self.classifier = nn.Sequential(
            nn.Flatten(),
            nn.Linear(n_temporal_filters, 128),
            nn.ELU(),
            nn.Dropout(dropout),
            nn.Linear(128, n_classes), # which is 7!
        )

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        """
        Args:
            x : (batch, time_steps, n_channels)
        Returns:
            logits : (batch, n_classes)
        """
        # Conv1d expects (batch, channels, time) → transpose
        # summary of dimensions:
        x = x.permute(0, 2, 1)                 # → (B, 7, T)

        x = self.spatial_conv(x)               # → (B, 32, T)
        x = self.temporal_fine(x)              # → (B, 64, T/2)
        x = self.temporal_mid(x)               # → (B, 64, T/4)
        x = self.temporal_coarse(x)            # → (B, 64, T/8)

        x = self.pool(x)                       # → (B, 64, 1)
        return self.classifier(x)              # → (B, n_classes)


# ─────────────────────────────────────────
# 5. TRAINING UTILITIES
# ─────────────────────────────────────────
def train_one_epoch(model, loader, criterion, optimizer, device):
    model.train()
    total_loss, correct, total = 0.0, 0, 0

    for X_batch, y_batch in loader:
        X_batch, y_batch = X_batch.to(device), y_batch.to(device)

        optimizer.zero_grad()
        logits = model(X_batch)
        loss   = criterion(logits, y_batch)
        loss.backward()
        optimizer.step()

        total_loss += loss.item() * len(y_batch)
        correct    += (logits.argmax(1) == y_batch).sum().item()
        total      += len(y_batch)

    return total_loss / total, correct / total


@torch.no_grad()
def evaluate(model, loader, criterion, device):
    model.eval()
    total_loss, correct, total = 0.0, 0, 0
    all_preds, all_labels = [], []

    for X_batch, y_batch in loader:
        X_batch, y_batch = X_batch.to(device), y_batch.to(device)

        logits = model(X_batch)
        loss   = criterion(logits, y_batch)

        total_loss += loss.item() * len(y_batch)
        preds       = logits.argmax(1)
        correct    += (preds == y_batch).sum().item()
        total      += len(y_batch)
        all_preds  .extend(preds.cpu().numpy())
        all_labels .extend(y_batch.cpu().numpy())

    return total_loss / total, correct / total, all_preds, all_labels


# ─────────────────────────────────────────
# 6. TRAINING LOOP
# ─────────────────────────────────────────
def train(
    model,
    train_loader,
    val_loader,
    n_epochs:  int   = 50,
    lr:        float = 1e-3,
    patience:  int   = 10,
    device:    str   = "cpu",
):
    criterion = nn.CrossEntropyLoss()
    optimizer = optim.Adam(model.parameters(), lr=lr, weight_decay=1e-4)
    scheduler = optim.lr_scheduler.ReduceLROnPlateau(
        optimizer, mode="min", factor=0.5, patience=5
    )

    history = {"train_loss": [], "train_acc": [], "val_loss": [], "val_acc": []}
    best_val_loss  = float("inf")
    patience_count = 0

    print(f"\n{'Epoch':>6} {'Train Loss':>11} {'Train Acc':>10} "
          f"{'Val Loss':>10} {'Val Acc':>9}")
    print("─" * 52)

    for epoch in range(1, n_epochs + 1):
        tr_loss, tr_acc = train_one_epoch(model, train_loader, criterion, optimizer, device)
        vl_loss, vl_acc, _, _ = evaluate(model, val_loader, criterion, device)
        scheduler.step(vl_loss)

        history["train_loss"].append(tr_loss)
        history["train_acc"] .append(tr_acc)
        history["val_loss"]  .append(vl_loss)
        history["val_acc"]   .append(vl_acc)

        print(f"{epoch:>6} {tr_loss:>11.4f} {tr_acc:>10.4f} "
              f"{vl_loss:>10.4f} {vl_acc:>9.4f}")

        # Early stopping
        if vl_loss < best_val_loss:
            best_val_loss  = vl_loss
            patience_count = 0
            torch.save(model.state_dict(), "best_eeg_model.pt")
        else:
            patience_count += 1
            if patience_count >= patience:
                print(f"\nEarly stopping at epoch {epoch}.")
                break

    return history


# ─────────────────────────────────────────
# 7. PLOTTING
# ─────────────────────────────────────────
def plot_history(history: dict):
    fig, axes = plt.subplots(1, 2, figsize=(12, 4))

    for ax, metric, title in zip(
        axes,
        [("train_loss", "val_loss"), ("train_acc", "val_acc")],
        ["Loss", "Accuracy"],
    ):
        ax.plot(history[metric[0]], label="Train")
        ax.plot(history[metric[1]], label="Validation")
        ax.set_title(title)
        ax.set_xlabel("Epoch")
        ax.legend()
        ax.grid(True, alpha=0.3)

    plt.tight_layout()
    plt.savefig("training_history.png", dpi=150)
    plt.show()
    print("Saved → training_history.png")


